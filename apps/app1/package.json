    "lint": "eslint src",
    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch"
  },
  "dependencies": {
    "@app1/components": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.5.0",
    "@my-org/components": "workspace:*",
    "@my-org/hooks": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.5.1",
    "@babel/core": "^7.27.4",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-relay": "^21.0.1",
    "@rspack/cli": "^1.4.5",
    "@rspack/core": "^1.4.5",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "@rstest/core": "^0.10.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "cross-env": "^7.0.3",
    "typescript": "5.9.3"
