{
  "name": "app1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development rspack serve --config rspack.config.mjs",
    "build": "cross-env NODE_ENV=production rspack build --config rspack.config.mjs",
    "typecheck": "tsc --noEmit",
